<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Support for defining Web Components in Sutil</Description>
        <TargetFramework>netstandard2.0</TargetFramework>
        <FablePackageType>library</FablePackageType>
        <PackageTags>fable-javascript</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="WebComponent.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sutil\Sutil.fsproj" />
    </ItemGroup>
    <!-- Add native JS files to "fable" folder in Nuget package -->
    <ItemGroup>
        <Content Include="webcomponentinterop.js; adoptedStyleSheets.js;" PackagePath="fable" />
    </ItemGroup>
</Project>