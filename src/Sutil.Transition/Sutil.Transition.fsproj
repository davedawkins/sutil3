<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Transition effects for Sutil</Description>
        <TargetFramework>netstandard2.0</TargetFramework>
        <FablePackageType>library</FablePackageType>
        <PackageTags>fable-javascript</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Easing.fs" />
        <Compile Include="Transition.fs" />
        <Compile Include="TransitionFunctions.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sutil\Sutil.fsproj" />
    </ItemGroup>
</Project>