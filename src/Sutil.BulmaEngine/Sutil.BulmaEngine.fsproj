<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Adapter for Feliz.Engine.Bulma</Description>
        <TargetFramework>netstandard2.0</TargetFramework>
        <FablePackageType>library</FablePackageType>
        <PackageTags>fable-javascript</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="BulmaEngine.fs" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Sutil\Sutil.fsproj" />
        <ProjectReference Include="..\Sutil.Html\Sutil.Html.fsproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Feliz.Engine.Bulma" />
    </ItemGroup>
</Project>